# orbit-be's API base, without a trailing slash. The browser never calls it directly:
# every request goes through /api/orbit/*, which attaches the session token.
ORBIT_API_URL="https://api.dev.puckoops.com/orbit-be/api/v1"

# user-svc's API base: sign-up, email confirmation and sign-in, all server-side.
USER_SVC_URL="https://api.dev.puckoops.com/user-svc-smm/api/v1"
